# ==============================================================================
# PhonePe Payment Gateway Microservice — Environment Configuration
# ==============================================================================

# Application Environment (development | staging | production | test)
APP_ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
PUBLIC_BASE_URL=https://paymentgateway.gecnoguru.com

# Database Connection (PostgreSQL with asyncpg)
DATABASE_URL=postgresql+asyncpg://pguser:pgpass@localhost:5432/payment_gateway
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_ECHO=false

# Redis Connection (Token cache, Rate Limiting, Idempotency)
REDIS_URL=redis://localhost:6379/0

# ==============================================================================
# Security & Cryptography Keys
# ==============================================================================
# Master Fernet symmetric encryption key used to encrypt PhonePe client secrets at rest.
# Generate a new key with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MASTER_ENCRYPTION_KEY=8vXQ9c4lC6h3TzWzL9hJ7f3rK1mP5sQ8wY2uI0vE4aM=

# Master Admin API Key used to access the /admin endpoints for creating tenants & API keys
ADMIN_API_KEY=admin_secret_super_secure_key_change_in_production

# Per-API-key rate limit (requests per minute)
RATE_LIMIT_PER_MINUTE=120

# ==============================================================================
# PhonePe Upstream Endpoints
# ==============================================================================
# Sandbox / Preprod
PHONEPE_SANDBOX_AUTH_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/v1/oauth/token
PHONEPE_SANDBOX_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Production
PHONEPE_PROD_AUTH_URL=https://api.phonepe.com/apis/hermes/v1/oauth/token
PHONEPE_PROD_BASE_URL=https://api.phonepe.com/apis/hermes

# ==============================================================================
# Background Reconciliation & Webhook Delivery
# ==============================================================================
ENABLE_BACKGROUND_RECONCILIATION=true
RECONCILIATION_INTERVAL_SECONDS=300
RECONCILIATION_ORDER_AGE_THRESHOLD_MINUTES=5
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=10.0
